{
  "name": "@kitlangton/nback",
  "version": "0.1.0",
  "description": "An adaptive dual n-back trainer for the terminal",
  "keywords": [
    "dual-n-back",
    "n-back",
    "working-memory",
    "tui",
    "terminal",
    "brain-training"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitlangton/nback.git"
  },
  "bin": {
    "nback": "./dist/bin/index.js"
  },
  "files": [
    "audio",
    "dist"
  ],
  "scripts": {
    "audio:generate": "bun run scripts/generate-audio.ts",
    "audio:tune": "bun run scripts/tune-audio.tsx",
    "build": "bun run scripts/build.ts",
    "dev": "bun run src/index.tsx",
    "prepack": "bun run scripts/build.ts",
    "start": "bun run src/index.tsx",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opentui/core": "0.4.5",
    "@opentui/solid": "0.4.5",
    "effect": "4.0.0-beta.97",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
